# ── Database (PostgreSQL) ──
DATABASE_URL="postgresql://moodmenu:moodmenu123@localhost:5432/moodmenu"

# Docker-only DB credentials
POSTGRES_USER="moodmenu"
POSTGRES_PASSWORD="change-this-in-production"
POSTGRES_DB="moodmenu"

# ── Auth ──
NEXTAUTH_SECRET="generate-a-long-random-secret-32chars-min"
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# ── Cloudinary (image uploads) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── OpenWeatherMap (weather-based theming) ──
OPENWEATHERMAP_API_KEY=""

# ── OneSignal (push notifications, optional) ──
NEXT_PUBLIC_ONESIGNAL_APP_ID=""

# ── Docker build ──
# Set to "true" for Docker standalone builds
# STANDALONE=true
