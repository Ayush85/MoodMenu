# ─────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────

# Docker uses service name "db" as hostname
DATABASE_URL="postgresql://menuor:your_password@db:5432/menuor"

POSTGRES_USER="menuor"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="menuor"


# ─────────────────────────────
# Authentication
# ─────────────────────────────

NEXTAUTH_SECRET="generate-a-long-random-secret-min-32-chars"

# Local development:
# NEXTAUTH_URL="http://localhost:3000"

# Production:
NEXTAUTH_URL="https://your-domain.com"

APP_BASE_URL="https://your-domain.com"


# ─────────────────────────────
# File Upload Storage
# ─────────────────────────────

# Docker persistent storage path
# Host:
# ./storage/uploads
#
# Container:
# /app/uploads
#
# Served back to the browser via src/app/uploads/[filename]/route.ts
# as a relative path, so it works under any domain automatically.

UPLOAD_DIR="/app/uploads"


# ─────────────────────────────
# FTP access to uploaded files (localhost only)
# ─────────────────────────────

FTP_USER="menuor"

FTP_PASSWORD="generate-a-strong-password"


# ─────────────────────────────
# Cloudinary (Optional)
# ─────────────────────────────
# Leave empty when using Docker local storage

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# ─────────────────────────────
# AI Provider (Menu Photo Import)
# ─────────────────────────────

# Options:
# gemini
# openai
# claude

AI_PROVIDER="gemini"

GEMINI_API_KEY=""

OPENAI_API_KEY=""

ANTHROPIC_API_KEY=""


# AI-generated item images (Claude cannot generate images)
# Options:
# openai (gpt-image-1)
# gemini (gemini-2.5-flash-image)

AI_IMAGE_PROVIDER="gemini"


# ─────────────────────────────
# Weather API
# ─────────────────────────────

OPENWEATHERMAP_API_KEY=""


# ─────────────────────────────
# Push Notifications (Optional)
# ─────────────────────────────

NEXT_PUBLIC_ONESIGNAL_APP_ID=""

ONESIGNAL_REST_API_KEY=""


# ─────────────────────────────
# Docker / Next.js Build
# ─────────────────────────────

# Enable Next.js standalone output
STANDALONE=true