generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum CallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum OrderStatus {
  NEW
  PREPARING
  SERVED
  PAID
  CANCELED
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum StaffRole {
  WAITER
  COOK
  CHEF
}

enum OfferType {
  BUY_ONE_GET_ONE
  PERCENTAGE
  FIXED_AMOUNT
  HAPPY_HOUR
  CUSTOM
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String?
  name        String
  role        Role         @default(ADMIN)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  restaurants Restaurant[]
}

model Restaurant {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  city             String
  latitude         Float?
  longitude        Float?
  logo             String?
  brandTheme       Json?
  cardStyle        String            @default("list")
  layoutTemplate   String            @default("classic")
  customDomain     String?           @unique
  domainVerifiedAt DateTime?
  landingEnabled   Boolean           @default(false)
  landingPage      Json?
  wifiSsid         String?
  wifiPassword     String?
  allowedIp        String?
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  categories       Category[]
  moodRules        MoodRule[]
  tables           RestaurantTable[]
  waiterCalls      WaiterCall[]
  orders           OrderTicket[]
  staffMembers     RestaurantStaff[]
  sessions         TableSession[]
  expenses         Expense[]
  offers           Offer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model RestaurantStaff {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String?
  phone        String?
  role         StaffRole
  isActive     Boolean    @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model RestaurantTable {
  id           String         @id @default(cuid())
  number       Int
  label        String?
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  waiterCalls  WaiterCall[]
  orders       OrderTicket[]
  sessions     TableSession[]

  @@unique([restaurantId, number])
}

model TableSession {
  id             String          @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status         SessionStatus   @default(ACTIVE)
  totalAmount    Float           @default(0)
  startedAt      DateTime        @default(now())
  lastActivityAt DateTime        @default(now())
  endedAt        DateTime?
  orders         OrderTicket[]

  @@index([tableId, status])
  @@index([restaurantId, status])
}

model WaiterCall {
  id             String          @id @default(cuid())
  status         CallStatus      @default(PENDING)
  message        String?
  tableId        String
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  handledBy      String?

  @@index([restaurantId, status])
  @@index([tableId, status, createdAt])
}

model OrderTicket {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      TableSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status       OrderStatus     @default(NEW)
  note         String?
  total        Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        OrderLine[]

  @@index([tableId, createdAt])
  @@index([sessionId, status])
  @@index([restaurantId, status])
}

model OrderLine {
  id        String      @id @default(cuid())
  orderId   String
  order     OrderTicket @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName  String
  quantity  Int         @default(1)
  unitPrice Float
  lineTotal Float
}

model Category {
  id           String     @id @default(cuid())
  name         String
  order        Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean  @default(true)
  isSpecial   Boolean  @default(false)
  tags        String[]
  order       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ExpenseCategory {
  INGREDIENTS
  UTILITIES
  STAFF
  RENT
  MAINTENANCE
  MARKETING
  EQUIPMENT
  OTHER
}

model Expense {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  amount       Float
  category     ExpenseCategory @default(OTHER)
  note         String?
  date         DateTime        @default(now())
  createdAt    DateTime        @default(now())
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model MoodRule {
  id           String     @id @default(cuid())
  name         String
  condition    Json       @default("{}")
  theme        Json       @default("{}")
  featuredTags String[]
  priority     Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Offer {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  type         OfferType @default(CUSTOM)
  value        Float?
  currency     String    @default("NPR")
  startsAt     DateTime?
  endsAt       DateTime?
  daysOfWeek   Int[]
  startTime    String?
  endTime      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([restaurantId, isActive, startsAt, endsAt])
}
