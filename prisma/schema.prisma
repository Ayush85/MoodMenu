generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String?
  name          String
  role          Role         @default(ADMIN)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  restaurants   Restaurant[]
}

model Restaurant {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  city          String
  latitude      Float?
  longitude     Float?
  logo          String?
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])
  categories    Category[]
  moodRules     MoodRule[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Category {
  id            String       @id @default(cuid())
  name          String
  order         Int          @default(0)
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items         MenuItem[]
}

model MenuItem {
  id            String       @id @default(cuid())
  name          String
  description   String?
  price         Float
  image         String?
  isAvailable   Boolean      @default(true)
  tags          String[]
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model MoodRule {
  id            String       @id @default(cuid())
  name          String
  condition     Json         @default("{}")
  theme         Json         @default("{}")
  featuredTags  String[]
  priority      Int          @default(0)
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
